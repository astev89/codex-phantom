APP_ENV=development
PORT=3210
CODEX_PHANTOM_DATA_DIR=./data
CODEX_PHANTOM_DATABASE_PATH=./data/codex-phantom.sqlite
OPENAI_MODEL=gpt-5
ROLE_CONFIG_PATH=./config/roles.yaml
OPERATOR_CONFIG_PATH=./config/operator.yaml
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CONVERSATION_MODE=previous_response_id
OPENAI_REASONING_EFFORT=medium
OPENAI_MEMORY_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_TIMEOUT_MS=10000
SEMANTIC_RETRIEVAL_ENABLED=true
QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=codex-phantom-memory
QDRANT_TIMEOUT_MS=5000
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_USER_ID=
# Email channel is disabled by default.
# Enabling it requires both IMAP and SMTP config.
# Polling is bounded by the interval, batch, and size limits below.
# Use app passwords or provider-specific mailbox credentials.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_TLS=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Codex Phantom
EMAIL_POLL_INTERVAL_MS=30000
EMAIL_POLL_BATCH_SIZE=10
EMAIL_MAX_MESSAGE_BYTES=1048576
EMAIL_MAX_ATTACHMENT_BYTES=200000
EMAIL_SEND_TIMEOUT_MS=10000
AGENT_NAME=Codex Phantom
OPERATOR_BEARER_TOKEN=replace-me
MCP_BEARER_TOKEN=replace-me
EXTERNAL_CHANNEL_SECRET=replace-me
REJECT_DEFAULT_SECRETS=true
LOG_LEVEL=info
MEMORY_EMBEDDING_BATCH_SIZE=8
MEMORY_TOP_K=12
MEMORY_PER_CATEGORY_LIMIT=3
MEMORY_SUMMARY_LIMIT=2
MEMORY_SUMMARY_TRIGGER_COUNT=6
MEMORY_SUMMARY_CLUSTER_SIZE=4
DEFAULT_RUN_TIMEOUT_MS=30000
DEFAULT_MAX_TOOL_CALLS=6
